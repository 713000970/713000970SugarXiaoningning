{
  "version": 2,
  "builds": [
    { "src": "api/**/*.js", "use": "@vercel/node" },
    { "src": "**/*", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/bbm-brand", "dest": "/api/bbm-brand.js" },
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/(.*)", "dest": "/$1" }
  ],
  "functions": {
    "api/bbm-brand.js": {
      "maxDuration": 30
    },
    "api/share-ratio.js": {
      "maxDuration": 30
    }
  }
}
